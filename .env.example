# Salin menjadi .env lalu jalankan `npm run dev`

# API Al-Qur'an (daftar surah, ayat, audio, tafsir)
NEXT_PUBLIC_API_URL=https://equran.id/api/v2

# API jadwal sholat, kota, imsakiyah & kalender Hijriah
NEXT_PUBLIC_PRAYER_API_URL=https://api.myquran.com/v2

# Opsional: versi aplikasi yang tampil di aplikasi Android (diisi otomatis oleh GitHub Actions)
# NEXT_PUBLIC_APP_VERSION=1.1.0
